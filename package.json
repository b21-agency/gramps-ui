  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:fetch-spec": "curl -fsS ${GRAMPS_API_TARGET:-http://localhost:5055}/api/openapi.json -o src/api/config/openapi.json && tsx src/api/config/fix-spec.ts",
    "api:generate": "cd src/api/config && rtk-query-codegen-openapi openapi-config.cjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.17",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.60.0",
    "maplibre-gl": "^6.15.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.5.0",
